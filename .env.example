# Copy to .env and fill in. Never commit the real .env.

# Broker portal
E2E_BASE_URL=https://d2cs2jbxolv7r7.cloudfront.net
E2E_EMAIL=
E2E_PASSWORD=

# Gmail OAuth - local first run (desktop client secret JSON downloaded from GCP)
GMAIL_CLIENT_SECRET_FILE=auth/client_secret.json
GMAIL_TOKEN_FILE=auth/gmail_token.json

# Gmail OAuth - CI / headless (from scripts/gmail_bootstrap.py; takes precedence)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# OTP polling (optional)
OTP_TIMEOUT_SECONDS=90
OTP_POLL_INTERVAL_SECONDS=3
OTP_REGEX=Verification Details:\s*(\d{6})
